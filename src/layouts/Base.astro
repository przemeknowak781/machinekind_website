---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { asset, link } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  links?: { href: string; label: string }[];
  navLabel?: string;
  navHref?: string;
}

const {
  title,
  description,
  links,
  navLabel = 'Machinekind',
  navHref = link(),
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://machinekind.ai');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#bd3e3e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Machinekind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // Po odświeżeniu przeglądarka przywraca poprzednie przewinięcie. Skoro
      // pozycja dłoni jest funkcją przewinięcia, scena startowała wtedy już
      // zjechana w dół, a wejście grało do złej pozycji. Strona zaczyna się
      // od góry — musi być inline w <head>, bo skrypt odroczony biegnie po
      // przywróceniu pozycji.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Przejdź do treści</a>
    <Nav links={links} label={navLabel} href={navHref} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Zapas dla przeglądarek bez osi czasu przewijania. Ustawia to samo
      // `--p`, którym w CSS steruje scroll(). Wyłącznie dekoracja: bez tego
      // skryptu scena po prostu stoi.
      const scene = document.querySelector<HTMLElement>('.scroll-scene');
      const native = CSS.supports('animation-timeline', 'scroll()');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (scene && !native && !still) {
        let ticking = false;
        const update = () => {
          const p = Math.min(1, Math.max(0, window.scrollY / window.innerHeight));
          scene.style.setProperty('--p', String(p));
          ticking = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        update();
      }
    </script>
  </body>
</html>
