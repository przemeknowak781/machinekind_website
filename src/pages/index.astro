---
import Base from '../layouts/Base.astro';
import HandsScene from '../components/HandsScene.astro';
import HeroHands from '../components/HeroHands.astro';
import HandsBackdrop from '../components/HandsBackdrop.astro';
import TeamGrid from '../components/TeamGrid.astro';
import { Image } from 'astro:assets';
import { machinekind, machinekindCount } from '../data/team';
import { asset } from '../lib/paths';
import korpus from '../assets/korpus.webp';
import naped from '../assets/naped-bezposredni.webp';

// Strona projektu Wojtek. Docelowo podstrona /wojtek, na razie osobny serwis.
const WOJTEK_URL = 'https://machinekind.ai';

// Takt maszyny — trzy warstwy sterowania, każda o rząd wielkości wolniejsza
// od poprzedniej: im wyżej, tym rzadziej i tym bardziej o zamiarze niż
// o momencie na wale. Nazwy warstw i częstotliwości za machinekind.ai.
const clock = [
  { hz: '400 Hz', what: 'pętla momentu' },
  { hz: '50 Hz', what: 'sieć lokomocyjna' },
  { hz: '1 Hz', what: 'rozumienie przestrzeni' },
];

// Liczebnik po polsku: 1 osoba, 2–4 osoby, 5+ osób, z wyjątkiem nastek.
function osoby(n: number): string {
  const last = n % 10;
  const teen = n % 100 >= 12 && n % 100 <= 14;
  if (n === 1) return 'osoba';
  if (!teen && last >= 2 && last <= 4) return 'osoby';
  return 'osób';
}

// Liczność każdej domeny bierze się ze składu zespołu, więc „po dwie osoby
// w każdej" nie rozjedzie się z siatką zespołu niżej.
const headcount = Object.fromEntries(machinekind.map((g) => [g.label, g.members.length]));

const domains = [
  {
    label: 'Locomotion AI',
    title: 'Chód uczony w symulacji.',
    body:
      'Sieci sterujące chodem trenujemy w symulatorze pełnej dynamiki, a te same trajektorie przenosimy na maszynę.',
    meta: '300 mln kroków · sim-to-real',
  },
  {
    label: 'World Models & VLM',
    title: 'Rozumienie przestrzeni.',
    body:
      'Modele świata i modele wizyjno-językowe dają maszynie kontekst: co widzi, gdzie może stanąć i co z tego wynika dla następnego kroku.',
    meta: 'VLM · zamiar',
  },
  {
    label: 'Robotics Engineering & Manufacturing',
    title: 'Konstrukcja i napędy.',
    body:
      'Napędy bezpośrednie, nogi o zamkniętym łańcuchu kinematycznym, sztywność wzięta ze struktury zamiast z dodatkowej masy.',
    meta: 'direct drive · closed-loop',
  },
  {
    label: 'Design & Program',
    title: 'Prowadzenie i forma.',
    body:
      'Harmonogram, prowadzenie projektu i to, jak maszyna wygląda. Forma wynika z obciążenia: każde wycięcie odprowadza ciepło.',
    meta: 'program · design',
  },
];

// Trzy zasady, na których stoi kolektyw. Nie opis podziału pracy z kimkolwiek
// z zewnątrz, tylko to, co robimy sami i czym się to kończy.
const stance = [
  {
    title: 'Budujemy, nie doradzamy.',
    body:
      'Każda domena kończy się czymś, co się uruchamia: siecią sterującą, ścieżką na maszynę, częścią, która wychodzi z obróbki. Nie oddajemy prezentacji.',
  },
  {
    title: 'Inteligencja powstaje razem ze sprzętem.',
    body:
      'Jeden zespół prowadzi całą drogę, od zamiaru po moment na wale. Model nie jest przerzucany przez mur do integracji, bo po drugiej stronie muru siedzą ci sami ludzie.',
  },
  {
    title: 'Pierwsza maszyna już chodzi.',
    body:
      'W01-TEK nie jest wizualizacją. Jest bazą platformy: kolejne wersje powstają na tej samej konstrukcji, a nie od zera.',
  },
];

// Sygnatura rozbita na litery, żeby każda mogła mieć zablokowaną szerokość.
// Bez tego podmiana glifów przy przesypywaniu rozjeżdżałaby napis w poziomie.
const WORDMARK = 'Machinekind'.split('');

---

<Base
  title="Machinekind, kolektyw robotyki i AI z Wrocławia"
  description="Machinekind to niezależny kolektyw inżynierów uczenia maszynowego, robotyków i projektantów. Cztery domeny w jednym zespole: od modelu, który rozumie scenę, po przegub, który przenosi moment. Pierwsza maszyna: czworonóg W01-TEK."
>
  <!-- ============ HERO ============ -->
  <section class="hero scroll-scene">
    <div class="hero__stage">
      <HeroHands />

      <div class="wrap hero__grid">
        <div class="hero__text">
          <h1
            class="h-display hero__title"
            aria-label="Machinekind"
            data-scramble
          >
            {WORDMARK.map((ch) => <span class="ch">{ch}</span>)}
          </h1>
          <p class="hero__claim after-hands">
            Uczymy maszyny poruszać się w świecie ludzi.
          </p>
          <p class="hero__sub after-hands">
            Kolektyw inżynierów uczenia maszynowego, robotyków i projektantów.
            Budujemy warstwę inteligencji <strong>razem ze sprzętem</strong>,
            na którym da się ją uruchomić.
          </p>
        </div>

        <div class="hero__actions after-hands after-hands--late">
          <a class="btn" href={WOJTEK_URL}>
            Projekt Wojtek
            <svg class="btn__arrow" width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <path d="M1 12 12 1M4 1h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a class="btn btn--ghost" href="#kontakt">Kontakt</a>
        </div>
      </div>
    </div>

    <div class="wrap">
      <p class="hero__meta mono after-hands after-hands--late">
        <span>Kolektyw, Wrocław</span>
        <span class="hero__meta-pair">
          <span>51.1079° N / 17.0385° E</span>
          <span>Est. 2025</span>
        </span>
      </p>
    </div>
  </section>

  <!-- ============ KOLEKTYW ============ -->
  <section class="section red has-backdrop" id="kolektyw">
    {/* Sekcja nazywa się „punkt styku", więc w tle stoją obie dłonie, a nie
        jedna: maszyna z lewej, człowiek z prawej, obie w górnej części kadru,
        nad kolumnami zespołów. */}
    <HandsBackdrop hand="robot" tone="paper" side="left" size="74%" top="26%" bleed="-29.5%" opacity={0.075} duration="30s" />
    <HandsBackdrop hand="human" tone="paper" side="right" size="72%" top="27%" bleed="-21%" opacity={0.085} />
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Punkt styku.</h2>
        <p class="lead">
          Machinekind jest niezależnym kolektywem. Powstał wokół jednego
          pytania: co musi się wydarzyć, żeby robot kroczący przestał być
          demonstracją, a stał się narzędziem. Odpowiedź wyszła jedna — trzeba
          go zbudować, całego, u siebie.
        </p>
      </div>

      <ol class="stance">
        {
          stance.map((r, i) => (
            <li class="rule-item">
              <span class="rule-item__no mono">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="rule-item__title">{r.title}</h3>
              <p class="rule-item__body">{r.body}</p>
            </li>
          ))
        }
      </ol>

      <p class="naming">
        <span class="mono naming__label">Nazwa</span>
        <span>
          Maszyny nie są osobnym gatunkiem. Są przedłużeniem tego, co ludzkie —
          a granica przebiega dokładnie tam, gdzie stykają się dwie dłonie.
        </span>
      </p>
    </div>
  </section>

  <!-- ============ DOMENY ============ -->
  <section class="section has-backdrop" id="domeny">
    <HandsBackdrop hand="robot" tone="ink" side="left" size="72%" top="18%" bleed="-30%" opacity={0.045} duration="32s" />
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Cały stos,<br />jeden zespół.</h2>
        <p class="lead">
          Cztery domeny, po dwie osoby w każdej. Razem obejmują całą drogę: od
          modelu, który rozumie scenę, po przegub, który przenosi moment.
          Żadnego odcinka nie oddajemy na zewnątrz.
        </p>
      </div>

      <p class="clock__label mono">Sterowanie, które utrzymujemy na maszynie</p>

      <ol class="clock">
        {
          clock.map((c) => (
            <li class="tick">
              <span class="tick__hz">{c.hz}</span>
              <span class="tick__what">{c.what}</span>
            </li>
          ))
        }
      </ol>

      <div class="domains">
        {
          domains.map((d, i) => (
            <article class="domain">
              <p class="domain__label">
                <span class="domain__index mono">{String(i + 1).padStart(2, '0')}</span>
                {d.label}
                <span class="domain__count mono">{headcount[d.label]} osoby</span>
              </p>
              <h3 class="h3 domain__title">{d.title}</h3>
              <p class="body domain__body">{d.body}</p>
              <p class="domain__meta mono">{d.meta}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROJEKTY ============ -->
  <section class="section section--tight" id="projekty">
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Pierwsza<br />maszyna.</h2>
        <p class="lead">
          W01-TEK chodzi we Wrocławiu. Jest bazą platformy — kolejne wersje
          powstają na tej samej konstrukcji.
        </p>
      </div>

      <a class="project" href={WOJTEK_URL}>
        <div class="project__media">
          <video
            src={asset('media/render-korpus.mp4')}
            poster={korpus.src}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-clip></video>
        </div>
        <div class="project__body">
          <p class="project__tag">Projekt 01 · aktywny</p>
          <h3 class="h2 project__title">Wojtek<span class="project__code">W01-TEK</span></h3>
          <p class="body">
            Czworonóg zbudowany we Wrocławiu: od szkicu do prototypu w rok,
            pierwszy krok w 2025, pełne sterowanie AI od 2026. Imię odziedziczył
            po niedźwiedziu, który dźwigał to, czego nie mógł unieść nikt inny.
          </p>
          <ul class="project__facts">
            <li><span>Typ</span>robot kroczący</li>
            <li><span>Budowa</span>12 miesięcy</li>
            <li><span>Napęd</span>bezpośredni</li>
          </ul>
          <p class="project__note">
            Projekt prowadzony z Politechniką Wrocławską; maszyna jest jej
            własnością. Szczegóły współpracy na stronie projektu.
          </p>
          <span class="project__go">
            Zobacz projekt
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <path d="M1 12 12 1M4 1h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>

      <figure class="detail">
        <Image
          src={naped}
          alt="Napęd bezpośredni maszyny W01-TEK: silnik sprzężony wprost z przegubem"
          widths={[720, 1440]}
          sizes="(min-width: 980px) 1180px, 100vw"
          loading="lazy"
        />
        <figcaption>Napęd bezpośredni: silnik sprzężony wprost z przegubem</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ ZESPÓŁ ============ -->
  <section class="section dark has-backdrop" id="zespol">
    <HandsBackdrop hand="robot" tone="paper" side="right" size="64%" top="9%" bleed="-26%" opacity={0.055} duration="30s" />
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Kto to robi.</h2>
        <p class="lead">
          {machinekindCount} osób, cztery domeny, po dwie na domenę. Każda para
          odpowiada za swój odcinek od pomysłu po uruchomienie na maszynie.
        </p>
      </div>

      <TeamGrid groups={machinekind} tone="dark" />
    </div>
  </section>

  <!-- ============ KONTAKT ============ -->
  <section class="section red contact" id="kontakt">
    <div class="wrap">
      <h2 class="h-display contact__title">Zbudujmy<br />następny.</h2>
      <div class="contact__row">
        <p class="lead">
          Maszyna chodzi we Wrocławiu i można ją zobaczyć w ruchu. Zapraszamy
          inwestorów, partnerów przemysłowych i media na pokaz.
        </p>
        <a class="btn" href="mailto:hello@wo1.tech">
          Umów pokaz
          <svg class="btn__arrow" width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <path d="M1 12 12 1M4 1h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <HandsScene variant="paper" class="contact__scene" />
    </div>
  </section>
</Base>

<script>
  // Sygnatura przesypuje litery, zanim ułoży się w słowo. Litery losowane są
  // wyłącznie ze zbioru liter samego słowa, więc szerokości zostają w tym
  // samym zakresie, a napis nie zamienia się w przypadkowy szum.
  //
  // Bez skryptu w nagłówku stoi po prostu gotowe słowo — efekt jest dodatkiem,
  // nie warunkiem czytelności. Nazwa dostępnościowa siedzi w aria-label, więc
  // czytnik ekranu nigdy nie przeczyta przesypywanych liter.
  const wordmark = document.querySelector<HTMLElement>('[data-scramble]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wordmark && !calm) {
    const cells = [...wordmark.querySelectorAll<HTMLElement>('.ch')];
    const target = cells.map((c) => c.textContent ?? '');
    const pool = [...new Set(target.map((c) => c.toUpperCase()))];

    const STEP = 132; // co tyle zatrzaskuje się kolejna litera: jedenaście
    // liter składa się w półtorej sekundy, czyli do chwili zetknięcia opuszków
    const TICK = 45; // co tyle podmienia się glif

    // Przesypywanie rusza w pierwszej klatce, razem z dłońmi, a nie po
    // opóźnieniu — słowo formuje się przez cały ich lot. Punktem zerowym jest
    // pierwsza klatka, w której kroje są już wczytane: dopiero wtedy można
    // zablokować szerokości kratek, a bez blokady napis skakałby w poziomie.
    // Do tego czasu litery już się przesypują, więc gotowe słowo nie mignie.
    let origin = 0;
    let lastTick = 0;

    const frame = (now: number) => {
      if (!origin) {
        if (document.fonts.status !== 'loaded') {
          // Kroju jeszcze nie ma, więc szerokości mierzyć nie ma z czego.
          // Litery już się przesypują — napis stoi w kratkach zwykłego tekstu
          // i może drgnąć, ale nie mignie gotowym słowem.
          cells.forEach((c) => {
            c.textContent = pool[(Math.random() * pool.length) | 0];
          });
          requestAnimationFrame(frame);
          return;
        }
        // Szerokość kratki bierze się z docelowej litery, nie z losowej.
        cells.forEach((c, i) => {
          c.textContent = target[i];
          c.style.width = `${c.getBoundingClientRect().width}px`;
        });
        origin = now;
      }

      const locked = Math.floor((now - origin) / STEP);
      if (locked >= cells.length) {
        cells.forEach((c, i) => (c.textContent = target[i]));
        return;
      }

      if (now - lastTick >= TICK) {
        lastTick = now;
        cells.forEach((c, i) => {
          if (i < locked) {
            if (c.textContent !== target[i]) {
              c.textContent = target[i];
              c.classList.add('ch--lock');
            }
          } else {
            c.textContent = pool[(Math.random() * pool.length) | 0];
          }
        });
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  // Film w karcie projektu rusza dopiero w kadrze i tylko wtedy, gdy widz
  // nie prosił o ograniczenie ruchu. Do tego czasu leży plakat, więc bez
  // skryptu strona nadal jest kompletna.
  const clip = document.querySelector<HTMLVideoElement>('video[data-clip]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (clip && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            clip.preload = 'auto';
            clip.play().catch(() => {});
          } else {
            clip.pause();
          }
        }
      },
      { threshold: 0.3 }
    );
    io.observe(clip);
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Jednostka kompozycji dłoni. Bierze mniejszą z miar okna, więc na
     szerokim i niskim ekranie scena kurczy się zamiast wyjeżdżać poza kadr. */
  .hero__stage {
    --hand-u: min(1vw, 1.55vh);
    position: relative;
    isolation: isolate;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  /* Tekst i przyciski rozchodzą się na przeciwne rogi sceny, żeby
     przekątna dłoni miała przez co przejść. */
  .hero__grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2.5rem, 8vw, 7rem);
    min-height: max(26rem, calc(54 * var(--hand-u)));
  }

  /* Ułożenie pionowe. Bryła ma twardy sufit w rem, bo przy 700px sama
     proporcja do szerokości robiła z niej kolos na dwa ekrany. Wysokość
     sceny liczy się z tej samej szerokości, więc nic się nie przycina. */
  /* Układ pionowy: tekst, pod nim dłonie, pod nimi przyciski. Wysokość
     bierze się z tych trzech rzeczy, a nie z osobnego minimum — stąd odstęp
     równy dokładnie wysokości dłoni plus światło, a nie „jakieś 21rem".
     `--hand-gap` mówi, ile zostaje pod bryłą: dolne dopełnienie sceny,
     przyciski i światło nad nimi. */
  @media (max-width: 779px) {
    .hero__stage {
      /* Bryła ma dwa ograniczenia: 160% szerokości okna, żeby dłonie
         wychodziły poza obie krawędzie, i 44% jego wysokości, żeby na
         tablecie nie zjadły całego ekranu. Sufit w `rem` tego nie umiał —
         przy 768px zatrzymywał bryłę w środku kadru z marginesami po bokach,
         przez co przekątna traciła cały impet. */
      --hand-h: min(calc(160vw / 1.6296), 44vh);
      --hand-w: calc(var(--hand-h) * 1.6296);
      --hand-gap: 6.5rem;
    }

    .hero__grid {
      min-height: 0;
      gap: calc(var(--hand-h) + 2.25rem);
    }
  }

  .hero__text {
    max-width: 46rem;
  }

  /* Sygnatura rodzi się w punkcie styku dłoni, na środku ekranu, i dopiero
     potem jedzie na swoje miejsce w układzie.

     `--title-x` to droga od lewej krawędzi kolumny tekstu do środka okna:
     połowa okna, minus połowa własnej szerokości, minus to, o ile kolumna
     jest odsunięta od krawędzi strony. Dzięki temu wyśrodkowanie wychodzi
     samo na każdej szerokości, bez liczby wpisanej na sztywno. */
  .hero__title {
    --title-x: calc(
      50vw - 50% - max(0px, (100vw - var(--wrap)) / 2) - var(--gutter)
    );
    --title-y: -5vh;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
    white-space: nowrap;
    animation: title-travel 3s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  /* Napis stoi na środku od zerowej sekundy i składa się z liter w tym
     samym czasie, w którym dłonie lecą ku sobie. Rusza z miejsca dopiero
     przy zetknięciu opuszków — w 56,8% biegu, czyli tam, gdzie zaczyna się
     obrót dłoni — i dojeżdża razem z nimi. Krycia nie ma w ogóle: napis
     albo stoi w pełnym atramencie, albo jeszcze nie ma w nim liter. */
  @keyframes title-travel {
    0% {
      translate: var(--title-x) var(--title-y);
    }
    57% {
      translate: var(--title-x) var(--title-y);
    }
    100% {
      translate: 0 0;
    }
  }

  /* W układzie pionowym kolumna tekstu zajmuje całą szerokość, więc napis
     i tak stoi na środku. Zostaje samo pojawienie się, bez przejazdu. */
  @media (max-width: 779px) {
    .hero__title {
      --title-x: 0px;
      --title-y: 0px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title {
      animation: none;
      translate: none;
      visibility: visible;
    }
  }

  /* Litera w kratce o zablokowanej szerokości: glif może się zmieniać,
     a napis stoi w miejscu. Przed zablokowaniem szerokości kratka zachowuje
     się jak zwykły tekst, więc bez skryptu nic się nie zmienia. */
  .ch {
    display: inline-block;
    text-align: center;
  }

  .ch--lock {
    animation: ch-lock 0.3s var(--ease);
  }

  @keyframes ch-lock {
    from {
      opacity: 0.5;
      translate: 0 0.05em;
    }
    to {
      opacity: 1;
      translate: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch--lock {
      animation: none;
    }
  }

  /* Podtytuł nagłówka czyta się inaczej niż akapit w środku strony: stoi
