---
import Base from '../layouts/Base.astro';
import HandsScene from '../components/HandsScene.astro';
import HeroHands from '../components/HeroHands.astro';
import HandsBackdrop from '../components/HandsBackdrop.astro';
import TeamGrid from '../components/TeamGrid.astro';
import { Image } from 'astro:assets';
import { machinekind, pwr, machinekindCount, pwrCount } from '../data/team';
import { asset } from '../lib/paths';
import korpus from '../assets/korpus.webp';
import naped from '../assets/naped-bezposredni.webp';

// Strona projektu Wojtek. Docelowo podstrona /wojtek, na razie osobny serwis.
const WOJTEK_URL = 'https://machinekind.ai';

const domains = [
  {
    label: 'Locomotion AI',
    title: 'Sterowanie chodem uczone w symulacji.',
    body:
      'Sieci sterujące chodem trenujemy w symulatorze pełnej dynamiki, a potem przenosimy te same trajektorie na maszynę. Pętla momentu pracuje w 400 Hz, sieć lokomocyjna w 50 Hz.',
    meta: ['300 mln kroków', 'sim-to-real'],
  },
  {
    label: 'World Models & VLM',
    title: 'Warstwa rozumienia przestrzeni.',
    body:
      'Modele świata i modele wizyjno-językowe dają maszynie kontekst: co widzi, gdzie może stanąć i co z tego wynika dla następnego kroku. Ta warstwa pracuje wolniej, w 1 Hz, i decyduje o zamiarze.',
    meta: ['VLM', '1 Hz'],
  },
  {
    label: 'Robotics Engineering',
    title: 'Konstrukcja, napędy i wykonanie.',
    body:
      'Napędy bezpośrednie, nogi o zamkniętym łańcuchu kinematycznym, sztywność wzięta ze struktury zamiast z dodatkowej masy. Wydruki 3D, cięcie laserowe, montaż i kalibracja na miejscu.',
    meta: ['direct drive', 'closed-loop'],
  },
  {
    label: 'Design & Program',
    title: 'Prowadzenie projektu i forma.',
    body:
      'Harmonogram, finansowanie, komunikacja i to, jak maszyna wygląda. Forma wynika z obciążenia: każde wycięcie odprowadza ciepło, każde przetłoczenie usztywnia strukturę.',
    meta: ['program', 'design'],
  },
];

// Sygnatura rozbita na litery, żeby każda mogła mieć zablokowaną szerokość.
// Bez tego podmiana glifów przy przesypywaniu rozjeżdżałaby napis w poziomie.
const WORDMARK = 'Machinekind'.split('');

const facts = [
  { label: 'Zespół', value: `${machinekindCount + pwrCount} osób w dwóch zespołach` },
  { label: 'Trening', value: '300 mln kroków w symulacji' },
  { label: 'Takt warstw', value: '400 / 50 / 1 Hz' },
  { label: 'Pierwszy krok', value: 'Wrocław, 2025' },
];
---

<Base
  title="Machinekind, kolektyw robotyki i AI z Wrocławia"
  description="Machinekind to kolektyw inżynierów uczenia maszynowego, robotyków i projektantów. Budujemy warstwę inteligencji dla maszyn działających w fizycznym świecie. Pierwsza maszyna: czworonóg W01-TEK."
>
  <!-- ============ HERO ============ -->
  <section class="hero scroll-scene">
    <div class="hero__stage">
      <HeroHands />

      <div class="wrap hero__grid">
        <div class="hero__text">
          <h1
            class="h-display hero__title"
            aria-label="Machinekind"
            data-scramble
          >
            {WORDMARK.map((ch) => <span class="ch">{ch}</span>)}
          </h1>
          <p class="lead after-hands">
            Uczymy maszyny poruszać się w świecie ludzi. Kolektyw inżynierów
            uczenia maszynowego, robotyków i projektantów. Budujemy warstwę
            inteligencji razem ze sprzętem, na którym da się ją uruchomić.
          </p>
        </div>

        <div class="hero__actions after-hands after-hands--late">
          <a class="btn" href={WOJTEK_URL}>
            Projekt Wojtek
            <svg class="btn__arrow" width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <path d="M1 12 12 1M4 1h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a class="btn btn--ghost" href="#kontakt">Kontakt</a>
        </div>
      </div>
    </div>

    <div class="wrap">
      <p class="hero__meta mono after-hands after-hands--late">
        <span>Kolektyw, Wrocław</span>
        <span class="hero__meta-pair">
          <span>51.1079° N / 17.0385° E</span>
          <span>Est. 2025</span>
        </span>
      </p>
    </div>
  </section>

  <!-- ============ KOLEKTYW ============ -->
  <section class="section red has-backdrop" id="kolektyw">
    <HandsBackdrop hand="human" tone="paper" side="right" size="92%" top="80%" bleed="-22%" opacity={0.085} />
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Punkt styku.</h2>
        <div class="manifest">
          <p class="lead">
            Nazwa bierze się z prostego założenia: maszyny nie są osobnym
            gatunkiem. Są przedłużeniem tego, co ludzkie, a granica między
            jednym a drugim przebiega dokładnie tam, gdzie stykają się dwie
            dłonie.
          </p>
          <p class="body">
            Machinekind powstał wokół jednej maszyny i jednego pytania: co musi
            się wydarzyć, żeby robot kroczący przestał być demonstracją, a stał
            się narzędziem. Pracujemy w dwóch zespołach. Po stronie Politechniki
            Wrocławskiej konstrukcja, mechanika i wykonanie, po naszej warstwa
            AI, inżynieria robotyki, design i prowadzenie projektu.
          </p>
        </div>
      </div>

      <dl class="facts">
        {
          facts.map((f) => (
            <div class="fact">
              <dt class="fact__label">{f.label}</dt>
              <dd class="fact__value">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ DOMENY ============ -->
  <section class="section has-backdrop" id="domeny">
    <HandsBackdrop hand="robot" tone="ink" side="left" size="72%" top="18%" bleed="-30%" opacity={0.045} duration="32s" />
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Cztery warstwy<br />jednej maszyny.</h2>
        <p class="lead">
          Nie dzielimy pracy na badania i wdrożenie. Każda z czterech domen
          kończy się czymś, co można uruchomić na sprzęcie stojącym
          w laboratorium.
        </p>
      </div>

      <div class="domains">
        {
          domains.map((d) => (
            <article class="domain">
              <div class="domain__main">
                <p class="domain__label">{d.label}</p>
                <h3 class="h3 domain__title">{d.title}</h3>
                <p class="body domain__body">{d.body}</p>
              </div>
              <ul class="domain__meta">
                {d.meta.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROJEKTY ============ -->
  <section class="section section--tight" id="projekty">
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Co stoi<br />w laboratorium.</h2>
        <p class="lead">
          Pierwsza maszyna platformy chodzi we Wrocławiu. Kolejne wersje
          powstają na tej samej bazie.
        </p>
      </div>

      <a class="project" href={WOJTEK_URL}>
        <div class="project__media">
          <video
            src={asset('media/render-korpus.mp4')}
            poster={korpus.src}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            data-clip></video>
        </div>
        <div class="project__body">
          <p class="project__tag">Projekt 01 · aktywny</p>
          <h3 class="h2 project__title">Wojtek<span class="project__code">W01-TEK</span></h3>
          <p class="body">
            Czworonóg zaprojektowany i zbudowany we Wrocławiu, na Politechnice
            Wrocławskiej. Od szkicu do prototypu w rok, pierwszy krok w 2025,
            pełne sterowanie AI od 2026. Imię odziedziczył po niedźwiedziu,
            który dźwigał to, czego nie mógł unieść nikt inny.
          </p>
          <ul class="project__facts">
            <li><span>Typ</span>robot kroczący</li>
            <li><span>Budowa</span>12 miesięcy</li>
            <li><span>Napęd</span>bezpośredni</li>
          </ul>
          <span class="project__go">
            Zobacz projekt
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <path d="M1 12 12 1M4 1h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ============ ZESPÓŁ ============ -->
  <section class="section dark has-backdrop" id="zespol">
    <HandsBackdrop hand="robot" tone="paper" side="right" size="64%" top="9%" bleed="-26%" opacity={0.055} duration="30s" />
    <div class="wrap">
      <div class="head">
        <h2 class="h1">Kto buduje maszynę.</h2>
        <p class="lead">
          Dwanaście osób w dwóch zespołach. Po stronie uczelni konstrukcja,
          mechanika i wykonanie. Po stronie Machinekind warstwa AI, inżynieria
          robotyki, design i prowadzenie projektu.
        </p>
      </div>

      <h3 class="team-head">
        Machinekind <span class="mono">{machinekindCount} osób</span>
      </h3>
      <TeamGrid groups={machinekind} tone="dark" />

      <h3 class="team-head team-head--second">
        Politechnika Wrocławska, Laboratorium Mechatroniki i Robotyki
        <span class="mono">{pwrCount} osoby</span>
      </h3>
      <TeamGrid groups={pwr} tone="dark" />
    </div>
  </section>

  <!-- ============ ZAPLECZE ============ -->
  <section class="section section--tight" id="partner">
    <div class="wrap partner">
      <div class="partner__text">
        <h2 class="h2">Politechnika Wrocławska.</h2>
        <p class="body">
          Maszyna powstała w Laboratorium Mechatroniki i Robotyki Katedry
          Podstaw Konstrukcji Maszyn i Układów Mechatronicznych, z finansowaniem
          z projektu zespołu prof. Radosława Zimroza. Czworonóg jest
          rozszerzeniem prowadzonej tam linii robotów mobilnych i inspekcyjnych.
        </p>
        <dl class="partner__facts">
          <div><dt>LMiR</dt><dd>miejsce budowy</dd></div>
          <div><dt>KPKMiUM</dt><dd>katedra</dd></div>
          <div><dt>AMICOS</dt><dd>projekt</dd></div>
        </dl>
      </div>
      <figure class="partner__media">
        <Image src={naped} alt="Napęd bezpośredni maszyny W01-TEK" widths={[520, 1040]} sizes="(min-width: 900px) 520px, 100vw" loading="lazy" />
        <figcaption>Napęd bezpośredni: silnik sprzężony wprost z przegubem</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ KONTAKT ============ -->
  <section class="section red contact" id="kontakt">
    <div class="wrap">
      <h2 class="h-display contact__title">Zbudujmy<br />następny.</h2>
      <div class="contact__row">
        <p class="lead">
          Prototyp chodzi we Wrocławiu. Zapraszamy inwestorów, partnerów
          przemysłowych i media na pokaz.
        </p>
        <a class="btn" href="mailto:hello@wo1.tech">
          Umów pokaz
          <svg class="btn__arrow" width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
            <path d="M1 12 12 1M4 1h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <HandsScene variant="paper" class="contact__scene" />
    </div>
  </section>
</Base>

<script>
  // Sygnatura przesypuje litery, zanim ułoży się w słowo. Litery losowane są
  // wyłącznie ze zbioru liter samego słowa, więc szerokości zostają w tym
  // samym zakresie, a napis nie zamienia się w przypadkowy szum.
  //
  // Bez skryptu w nagłówku stoi po prostu gotowe słowo — efekt jest dodatkiem,
  // nie warunkiem czytelności. Nazwa dostępnościowa siedzi w aria-label, więc
  // czytnik ekranu nigdy nie przeczyta przesypywanych liter.
  const wordmark = document.querySelector<HTMLElement>('[data-scramble]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wordmark && !calm) {
    const cells = [...wordmark.querySelectorAll<HTMLElement>('.ch')];
    const target = cells.map((c) => c.textContent ?? '');
    const pool = [...new Set(target.map((c) => c.toUpperCase()))];

    const STEP = 88; // co tyle zatrzaskuje się kolejna litera: jedenaście
    // liter składa się w niespełna sekundę, czyli do chwili zetknięcia opuszków
    const TICK = 45; // co tyle podmienia się glif

    // Przesypywanie rusza w pierwszej klatce, razem z dłońmi, a nie po
    // opóźnieniu — słowo formuje się przez cały ich lot. Punktem zerowym jest
    // pierwsza klatka, w której kroje są już wczytane: dopiero wtedy można
    // zablokować szerokości kratek, a bez blokady napis skakałby w poziomie.
    // Do tego czasu litery już się przesypują, więc gotowe słowo nie mignie.
    let origin = 0;
    let lastTick = 0;

    const frame = (now: number) => {
      if (!origin) {
        if (document.fonts.status !== 'loaded') {
          // Kroju jeszcze nie ma, więc szerokości mierzyć nie ma z czego.
          // Litery już się przesypują — napis stoi w kratkach zwykłego tekstu
          // i może drgnąć, ale nie mignie gotowym słowem.
          cells.forEach((c) => {
            c.textContent = pool[(Math.random() * pool.length) | 0];
          });
          requestAnimationFrame(frame);
          return;
        }
        // Szerokość kratki bierze się z docelowej litery, nie z losowej.
        cells.forEach((c, i) => {
          c.textContent = target[i];
          c.style.width = `${c.getBoundingClientRect().width}px`;
        });
        origin = now;
      }

      const locked = Math.floor((now - origin) / STEP);
      if (locked >= cells.length) {
        cells.forEach((c, i) => (c.textContent = target[i]));
        return;
      }

      if (now - lastTick >= TICK) {
        lastTick = now;
        cells.forEach((c, i) => {
          if (i < locked) {
            if (c.textContent !== target[i]) {
              c.textContent = target[i];
              c.classList.add('ch--lock');
            }
          } else {
            c.textContent = pool[(Math.random() * pool.length) | 0];
          }
        });
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }

  // Film w karcie projektu rusza dopiero w kadrze i tylko wtedy, gdy widz
  // nie prosił o ograniczenie ruchu. Do tego czasu leży plakat, więc bez
  // skryptu strona nadal jest kompletna.
  const clip = document.querySelector<HTMLVideoElement>('video[data-clip]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (clip && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            clip.preload = 'auto';
            clip.play().catch(() => {});
          } else {
            clip.pause();
          }
        }
      },
      { threshold: 0.3 }
    );
    io.observe(clip);
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Jednostka kompozycji dłoni. Bierze mniejszą z miar okna, więc na
     szerokim i niskim ekranie scena kurczy się zamiast wyjeżdżać poza kadr. */
  .hero__stage {
    --hand-u: min(1vw, 1.55vh);
    position: relative;
    isolation: isolate;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  /* Tekst i przyciski rozchodzą się na przeciwne rogi sceny, żeby
     przekątna dłoni miała przez co przejść. */
  .hero__grid {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2.5rem, 8vw, 7rem);
    min-height: max(26rem, calc(54 * var(--hand-u)));
  }

  /* Ułożenie pionowe. Bryła ma twardy sufit w rem, bo przy 700px sama
     proporcja do szerokości robiła z niej kolos na dwa ekrany. Wysokość
     sceny liczy się z tej samej szerokości, więc nic się nie przycina. */
  @media (max-width: 779px) {
    .hero__stage {
      --hand-w: min(calc(126 * var(--hand-u)), 34rem);
    }

    .hero__grid {
      min-height: calc(var(--hand-w) / 1.63 + 21rem);
    }
  }

  .hero__text {
    max-width: 46rem;
  }

  /* Sygnatura rodzi się w punkcie styku dłoni, na środku ekranu, i dopiero
     potem jedzie na swoje miejsce w układzie.

     `--title-x` to droga od lewej krawędzi kolumny tekstu do środka okna:
     połowa okna, minus połowa własnej szerokości, minus to, o ile kolumna
     jest odsunięta od krawędzi strony. Dzięki temu wyśrodkowanie wychodzi
     samo na każdej szerokości, bez liczby wpisanej na sztywno. */
  .hero__title {
    --title-x: calc(
      50vw - 50% - max(0px, (100vw - var(--wrap)) / 2) - var(--gutter)
    );
    --title-y: -5vh;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
    white-space: nowrap;
    animation: title-travel 2.2s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  /* Napis stoi na środku od zerowej sekundy i składa się z liter w tym
     samym czasie, w którym dłonie lecą ku sobie. Rusza z miejsca dopiero
     przy zetknięciu opuszków — w 56,8% biegu, czyli tam, gdzie zaczyna się
     obrót dłoni — i dojeżdża razem z nimi. Krycia nie ma w ogóle: napis
     albo stoi w pełnym atramencie, albo jeszcze nie ma w nim liter. */
  @keyframes title-travel {
    0% {
      translate: var(--title-x) var(--title-y);
    }
    56.8% {
      translate: var(--title-x) var(--title-y);
    }
    100% {
      translate: 0 0;
    }
  }

  /* W układzie pionowym kolumna tekstu zajmuje całą szerokość, więc napis
     i tak stoi na środku. Zostaje samo pojawienie się, bez przejazdu. */
  @media (max-width: 779px) {
    .hero__title {
      --title-x: 0px;
      --title-y: 0px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title {
      animation: none;
      translate: none;
      visibility: visible;
    }
  }

  /* Litera w kratce o zablokowanej szerokości: glif może się zmieniać,
     a napis stoi w miejscu. Przed zablokowaniem szerokości kratka zachowuje
     się jak zwykły tekst, więc bez skryptu nic się nie zmienia. */
  .ch {
    display: inline-block;
    text-align: center;
  }

  .ch--lock {
    animation: ch-lock 0.3s var(--ease);
  }

  @keyframes ch-lock {
    from {
      opacity: 0.5;
      translate: 0 0.05em;
    }
    to {
      opacity: 1;
      translate: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch--lock {
      animation: none;
    }
  }

  .hero__text .lead {
    max-width: 34ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .hero__actions {
      align-self: flex-end;
    }
  }

  /* Ten sam podział kolumn co nagłówki sekcji niżej, żeby pasek pod
     nagłówkiem strony siadał w rytmie strony, a nie rozjeżdżał się sam. */
  .hero__meta {
    display: grid;
    gap: 0.45rem clamp(2rem, 6vw, 5rem);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .hero__meta-pair {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 2rem;
    justify-content: space-between;
  }

  @media (min-width: 900px) {
    .hero__meta {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  /* ---------- fakty ---------- */
  .manifest {
    display: grid;
    gap: 1.25rem;
  }

  .facts {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--on-red-line);
  }

  @media (min-width: 780px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .fact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--on-red-line);
  }

  .fact__label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--on-red-1);
  }

  .fact__value {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--on-red-2);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- domeny ---------- */
  .domains {
    border-top: 1px solid var(--line);
  }

  .domain {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid var(--line);
    grid-template-columns: 1fr;
    transition: background-color 0.4s var(--ease);
  }

  @media (min-width: 900px) {
