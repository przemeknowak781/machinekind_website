---
import { Image } from 'astro:assets';
import robot from '../assets/hand-robot-ink.png';
import human from '../assets/hand-human-ink.png';
---

<div class="hands">
  <div class="hands__group">
    <div class="hand hand--robot">
      <Image
        src={robot}
        alt="Dłoń maszyny i dłoń człowieka wyciągnięte ku sobie"
        widths={[800, 1400, 2000]}
        sizes="60vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hand hand--human">
      <Image src={human} alt="" widths={[700, 1200, 1700]} sizes="50vw" loading="eager" />
    </div>
  </div>
</div>

<style>
  .hands {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Cała przekątna to jedna sztywna bryła o stałych proporcjach. Skaluje ją
     jedna jednostka, która patrzy i na szerokość, i na wysokość okna —
     przez samo `vw` na szerokim, niskim ekranie dłoń wychodziła poza kadr. */
  /* Bryłę kotwiczy punkt styku opuszków (53% / 55% jej kadru), a nie
     krawędź. Dzięki temu zetknięcie wypada dokładnie na środku szerokości
     sceny — przy kotwiczeniu do prawej lądowało na ok. 60%. */
  .hands__group {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -53% -55%;
    width: calc(96 * var(--hand-u));
    aspect-ratio: 88 / 54;
  }

  .hand {
    position: absolute;
  }

  .hand :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Udziały wewnątrz bryły. Skoro bryła ma stałe proporcje, procenty
     w obu osiach skalują się razem i opuszki nie rozjeżdżają się nigdy. */
  .hand--robot {
    width: 52.3%;
    left: 0;
    top: 61.8%;
    rotate: -24deg;
  }

  .hand--human {
    width: 43.2%;
    left: 56.3%;
    top: 17.4%;
    rotate: -33deg;
  }

  /* Wąski kadr nie pomieści przekątnej obok tekstu, więc bryła schodzi pod
     niego i wychodzi poza obie krawędzie. Środek na 62% wysokości sceny
     zostawia miejsce na tekst nad nią i przyciski pod nią. */
  @media (max-width: 779px) {
    .hands__group {
      top: 62%;
      width: var(--hand-w);
    }
  }

  /* ---------- Wejście na stronę ----------
     Sekwencja w dwóch taktach. Najpierw dłonie zjeżdżają z przeciwnych
     narożników w mocnym powiększeniu, aż zetkną się opuszkami. Potem
     powiększenie schodzi do jedynki i kompozycja siada na swoim miejscu.

     Podział na dwa elementy jest celowy: bryła niesie powiększenie,
     a każda dłoń własny dojazd. Dzięki temu `translate` obrotu i
     `translate` przewijania nie wchodzą sobie w drogę. */
  .hands__group {
    /* Punkt styku opuszków. Powiększenie obraca się wokół niego, więc
       miejsce zetknięcia stoi nieruchomo, a reszta sceny do niego zjeżdża. */
    transform-origin: 53% 55%;
    animation: hands-zoom 0.65s cubic-bezier(0.65, 0, 0.35, 1) 0.85s both;
  }

  @keyframes hands-zoom {
    from {
      scale: 1.9;
    }
    to {
      scale: 1;
    }
  }

  /* Dłonie dojeżdżają odrobinę dalej, niż wynosi ich miejsce docelowe,
     żeby opuszki naprawdę się zetknęły. Rozchodzą się do właściwego
     odstępu dopiero razem z oddalaniem kadru. */
  .hand--robot :global(img) {
    animation: enter-robot 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hand--human :global(img) {
    animation: enter-human 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes enter-robot {
    0% {
      translate: -78% 42%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    50% {
      translate: 9.5% -1.5%;
    }
    57% {
      translate: 9.5% -1.5%;
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    100% {
      translate: 0 0;
    }
  }

  @keyframes enter-human {
    0% {
      translate: 78% -42%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    50% {
      translate: -11% 1.5%;
    }
    57% {
      translate: -11% 1.5%;
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    100% {
      translate: 0 0;
    }
  }

  /* Przewijanie rozsuwa dłonie. `--p` biegnie od 0 do 1 na przestrzeni
     pierwszego ekranu; ustawia je oś czasu przewijania, a tam gdzie jej
     nie ma, skrypt zapasowy w Base. */
  .hand--robot {
    translate: calc(var(--p, 0) * -9%) calc(var(--p, 0) * 13%);
  }

  .hand--human {
    translate: calc(var(--p, 0) * 9%) calc(var(--p, 0) * -13%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hands__group,
    .hand :global(img) {
      animation: none;
      scale: none;
      translate: none;
      opacity: 1;
    }

    .hand {
      translate: none;
    }
  }
</style>
