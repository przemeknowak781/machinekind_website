---
// Sylwetki wektorowe wstawiane w treść strony, a nie przez <img>. Powód jest
// podwójny: kolor bierze się z CSS przez `currentColor`, a scena nie czeka na
// osobne żądanie — animacja wejścia startuje w zerowej sekundzie, więc dłonie
// muszą być na miejscu od razu.
import robot from '../assets/hand-robot.svg?raw';
import human from '../assets/hand-human.svg?raw';
---

<div class="hands">
  <div class="hands__group">
    <div
      class="hand hand--robot"
      role="img"
      aria-label="Dłoń maszyny i dłoń człowieka wyciągnięte ku sobie"
      set:html={robot}
    />
    <div class="hand hand--human" aria-hidden="true" set:html={human} />
  </div>
</div>

<style>
  .hands {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Cała przekątna to jedna sztywna bryła o stałych proporcjach. Skaluje ją
     jedna jednostka, która patrzy i na szerokość, i na wysokość okna —
     przez samo `vw` na szerokim, niskim ekranie dłoń wychodziła poza kadr. */
  /* Bryłę kotwiczy punkt styku opuszków (53% / 55% jej kadru), a nie
     krawędź. `--shift` mówi, gdzie ten punkt ma stać: -53% to środek
     szerokości sceny, czyli pozycja na czas zetknięcia. Docelowo bryła
     idzie w prawo, żeby zrobić miejsce nagłówkowi i akapitowi.

     Kadr jest szerszy niż okno i przedramię człowieka schodzi poza prawą
     krawędź. Inaczej przekątna kończyła się dwieście pikseli przed nią,
     a prawa dolna ćwiartka nagłówka stała pusta. Bryła rośnie względem
     punktu styku, czyli w 55% w górę i 45% w dół, więc przy powiększeniu
     nadgarstek maszyny nie schodzi pod dolną krawędź sceny.

     Szerokość ma dwa ograniczenia i bierze mniejsze. Miara z `--hand-u`
     rządzi na szerokim i wysokim ekranie. Sufit 82% szerokości okna
     wchodzi tam, gdzie okno jest niskie albo wąskie — bez niego bryła
     bywała szersza od kadru i z dłoni człowieka zostawały same opuszki
     przy prawej krawędzi. */
  .hands__group {
    --shift-meet: -53%;
    --shift-final: -22%;
    --anchor-y: -49%;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: var(--shift-final) var(--anchor-y);
    width: min(calc(104 * var(--hand-u)), 82vw);
    aspect-ratio: 88 / 54;
  }

  .hand {
    position: absolute;
    color: var(--ink);
  }

  .hand :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Udziały wewnątrz bryły. Skoro bryła ma stałe proporcje, procenty
     w obu osiach skalują się razem i opuszki nie rozjeżdżają się nigdy. */
  .hand--robot {
    width: 52.3%;
    left: 0;
    top: 61.8%;
    rotate: -24deg;
  }

  .hand--human {
    width: 43.2%;
    left: 56.3%;
    top: 17.4%;
    rotate: -33deg;
  }

  /* Wąski kadr nie pomieści przekątnej obok tekstu, więc bryła schodzi pod
     niego i wychodzi poza obie krawędzie. Środek na 62% wysokości sceny
     zostawia miejsce na tekst nad nią i przyciski pod nią. */
  /* W układzie pionowym dłonie leżą pod tekstem, więc nie muszą mu ustępować
     i zostają na środku także po złożeniu. */
  @media (max-width: 779px) {
    .hands__group {
      --shift-final: -53%;
      --anchor-y: -55%;
      top: 62%;
      width: var(--hand-w);
    }
  }


  /* ---------- Wejście na stronę ----------
     Sekwencja w dwóch taktach. Najpierw dłonie zjeżdżają z przeciwnych
     narożników w mocnym powiększeniu, aż zetkną się opuszkami. Potem
     powiększenie schodzi do jedynki i kompozycja siada na swoim miejscu.

     Podział na dwa elementy jest celowy: bryła niesie powiększenie,
     a każda dłoń własny dojazd. Dzięki temu `translate` obrotu i
     `translate` przewijania nie wchodzą sobie w drogę. */
  /* Bryła: w chwili zetknięcia stoi wyśrodkowana i powiększona, potem
     jednocześnie oddala się i przesuwa na miejsce docelowe. */
  .hands__group {
    transform-origin: 53% 55%;
    animation: hands-settle 0.95s cubic-bezier(0.65, 0, 0.35, 1) 1.25s both;
  }

  @keyframes hands-settle {
    from {
      scale: 1.9;
      translate: var(--shift-meet) -55%;
    }
    to {
      scale: 1;
      translate: var(--shift-final) var(--anchor-y);
    }
  }

  /* Dłonie wjeżdżają poziomo, bez obrotu, i stykają się opuszkami na
     wspólnej osi. Obrót w skos zaczyna się dopiero po zetknięciu i idzie
     w parze z oddalaniem kadru.

     `backwards` zamiast `both` jest tu konieczne: po animacji `translate`
     musi wrócić pod kontrolę przewijania, a `rotate` do kąta z układu.
     Przy `both` obie własności zostałyby zamrożone na ostatniej klatce. */
  .hand--robot {
    animation: enter-robot 2.2s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .hand--human {
    animation: enter-human 2.2s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  @keyframes enter-robot {
    0% {
      translate: -170% -66%;
      rotate: 0deg;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    50% {
      translate: 3.6% -66%;
      rotate: 0deg;
    }
    57% {
      translate: 3.6% -66%;
      rotate: 0deg;
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    100% {
      translate: 0 0;
      rotate: -24deg;
    }
  }

  @keyframes enter-human {
    0% {
      translate: 170% 142%;
      rotate: 0deg;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    50% {
      translate: -13% 142%;
      rotate: 0deg;
    }
    57% {
      translate: -13% 142%;
      rotate: 0deg;
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    100% {
      translate: 0 0;
      rotate: -33deg;
    }
  }

  /* Przewijanie rozsuwa dłonie. `--p` biegnie od 0 do 1 na przestrzeni
     pierwszego ekranu; ustawia je oś czasu przewijania, a tam gdzie jej
     nie ma, skrypt zapasowy w Base. */
  .hand--robot {
    translate: calc(var(--p, 0) * -9%) calc(var(--p, 0) * 13%);
  }

  .hand--human {
    translate: calc(var(--p, 0) * 9%) calc(var(--p, 0) * -13%);
  }

  @media (prefers-reduced-motion: reduce) {
    /* Bryła traci animację, ale nie `translate` — to jej kotwiczenie na
       punkcie styku, czyli układ, a nie ruch. Wyzerowane odrzucało
       zetknięcie na skraj ekranu. */
    .hands__group {
      animation: none;
      scale: none;
    }

    .hand {
      animation: none;
      translate: none;
      opacity: 1;
    }
  }
</style>
