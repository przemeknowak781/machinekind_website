---
import { Image } from 'astro:assets';
import handsInk from '../assets/hands-ink.png';
import handsPaper from '../assets/hands-paper.png';

interface Props {
  variant?: 'ink' | 'paper';
  class?: string;
}

const { variant = 'ink', class: className = '' } = Astro.props;
const src = variant === 'paper' ? handsPaper : handsInk;
---

<figure class={`scene scene--${variant} ${className}`}>
  <div class="scene__frame">
    <Image
      class="scene__img"
      src={src}
      alt="Dłoń maszyny i dłoń człowieka wyciągnięte ku sobie, palce wskazujące niemal się stykają"
      widths={[900, 1400, 1980, 2600]}
      sizes="(min-width: 1400px) 1320px, 100vw"
      loading="lazy"
    />
  </div>
</figure>

<style>
  .scene {
    margin: 0;
  }

  .scene__frame {
    position: relative;
  }

  .scene__img {
    width: 100%;
    height: auto;
  }

  /* Na wąskich ekranach cała scena spada do paska kilkudziesięciu pikseli,
     więc powiększamy ją i kadrujemy na punkcie styku — obraz jest symetryczny,
     więc środek kadru nadal wypada dokładnie między opuszkami. */
  @media (max-width: 760px) {
    .scene__frame {
      overflow: hidden;
    }

    .scene :global(.scene__img) {
      width: 178%;
      max-width: none;
      margin-inline: -39%;
    }
  }
</style>
