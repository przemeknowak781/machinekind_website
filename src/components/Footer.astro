---
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import { link } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__brand">
      <Image class="foot__mark" src={mark} alt="" width={132} densities={[1, 2]} />
      <p class="foot__claim">
        Kolektyw inżynierów uczących maszyny&nbsp;poruszać się w fizycznym świecie.
      </p>
    </div>

    <nav class="foot__col" aria-label="Strona">
      <h2 class="foot__label">Strona</h2>
      <a href={link('#kolektyw')}>Kolektyw</a>
      <a href={link('#domeny')}>Domeny</a>
      <a href={link('#projekty')}>Projekty</a>
      <a href={link('#zespol')}>Zespół</a>
    </nav>

    <nav class="foot__col" aria-label="Projekty">
      <h2 class="foot__label">Projekty</h2>
      <a class="foot__out" href="https://machinekind.ai">
        Wojtek, W01-TEK
        <svg width="11" height="11" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M1 12 12 1M4 1h8v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </nav>

    <div class="foot__col">
      <h2 class="foot__label">Kontakt</h2>
      <a href="mailto:hello@wo1.tech">hello@wo1.tech</a>
      <p class="foot__where">Wrocław, Polska<br />51.1079° N / 17.0385° E</p>
    </div>
  </div>

  <div class="wrap foot__base">
    <p>© {year} Machinekind</p>
    <p class="foot__note">Niezależny kolektyw. Wrocław.</p>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: #fff;
    padding-top: clamp(3.5rem, 7vw, 6rem);
  }

  .foot__inner {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3rem);
    grid-template-columns: 1fr;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 760px) {
    .foot__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1060px) {
    .foot__inner {
      grid-template-columns: 1.6fr repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .foot__brand img {
    width: 3.4rem;
    height: auto;
    border-radius: 3px;
    margin-bottom: 1.25rem;
  }

  .foot__claim {
    color: var(--on-dark-2);
    max-width: 34ch;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .foot__col {
    display: grid;
    align-content: start;
  }

  .foot__label {
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--on-dark-3);
    margin-bottom: 0.5rem;
  }

  /* Wysokość 44px robi cel dotykowy, nie tylko odstęp. */
  .foot__col a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    color: var(--on-dark-1);
    font-size: 0.95rem;
    width: fit-content;
    transition: color 0.25s var(--ease);
  }

  .foot__col a:hover {
    color: var(--red-soft);
  }

  .foot__out svg {
    flex: none;
    opacity: 0.6;
  }

  .foot__where {
    font-family: var(--mono);
    font-size: var(--micro);
    line-height: 1.7;
    color: var(--on-dark-3);
    margin-top: 0.6rem;
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--on-dark-line);
    font-size: var(--micro);
    color: var(--on-dark-3);
  }
</style>
